{"id": "pt-005", "input": {"task": "By what factor did income rise for the farmers who first adopted Tata Motors' solar irrigation?"}, "expected": {"tools": ["search_reports", "calculate"], "forbid": ["web_search"], "order": [["search_reports", "calculate"]], "reference": "From 60,000 to 1,60,000: about 2.7 times."}, "tags": ["search-then-calculate", "TATAMOTORS-FY25"]}
