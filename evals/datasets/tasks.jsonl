// Project 2: 25 multi-step tasks over the three reports. expected.tools must be called, forbid must not,
// order holds [before, after] pairs; reference is what the judge checks the answer against.
{"id": "pt-001", "input": {"task": "How many ITC ordinary shares could the stock options ITC granted during FY25 be converted into?"}, "expected": {"tools": ["search_reports", "calculate"], "forbid": ["web_search"], "order": [["search_reports", "calculate"]], "reference": "ITC granted 14,80,700 options, each for ten Ordinary Shares: 1,48,07,000 shares, about 14.8 million."}, "tags": ["search-then-calculate", "ITC-FY25"]}
