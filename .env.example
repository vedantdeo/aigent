# Copy to .env (git-ignored). Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...
# Only for organization-level keys (the API rejects them without a workspace). Find the ID under
# Console > Settings > Workspaces. A key created inside a workspace does not need this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Budget guards, in USD. Defaults shown. A tripped guard is information, not an obstacle.
# ENTROPIC_MAX_USD_PER_REQUEST=0.25   # worst case for one request: input plus the full max_tokens
# ENTROPIC_MAX_USD_PER_TURN=0.60      # the same, for one turn of the agent, which resends it all
# ENTROPIC_MAX_USD_PER_RUN=1.00       # one tool loop or one chat session
# ENTROPIC_MAX_USD_PER_WORKFLOW=0.25  # one workflow demo, checked before every call
# ENTROPIC_MAX_USD_PER_EVAL=2.00      # one eval over a whole dataset; a trip keeps the rows
#                                       already paid for and marks the report partial
# Three models, three jobs. ENTROPIC_MODEL is what Entropic thinks with; drop it to claude-sonnet-5
# for cheaper experimentation. ENTROPIC_JUDGE_MODEL is what grades an eval, and defaults to a
# different model on purpose: one asked to grade its own output favours it. ENTROPIC_SMALL_MODEL is
# where the routing workflow sends the questions that do not need the first.
# ENTROPIC_MODEL=claude-opus-5
# ENTROPIC_JUDGE_MODEL=claude-sonnet-5
# ENTROPIC_SMALL_MODEL=claude-haiku-4-5
