# Copy to .env (git-ignored). Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...
# Only for organization-level keys (the API rejects them without a workspace). Find the ID under
# Console > Settings > Workspaces. A key created inside a workspace does not need this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Only for the `sarvam` client: a key from dashboard.sarvam.ai.
# SARVAM_API_KEY=sk_...

# Budget guards, in USD. Defaults shown. A tripped guard is information, not an obstacle.
# AIGENT_MAX_USD_PER_REQUEST=0.25   # worst case for one request: input plus the full max_tokens
# AIGENT_MAX_USD_PER_TURN=0.60      # the same, for one turn of the agent, which resends it all
# AIGENT_MAX_USD_PER_RUN=1.00       # one tool loop or one chat session
# AIGENT_MAX_USD_PER_WORKFLOW=0.25  # one workflow demo, checked before every call
# AIGENT_MAX_USD_PER_EVAL=2.00      # one eval over a whole dataset; a trip keeps the rows
#                                       already paid for and marks the report partial
# Which endpoint to talk to: `anthropic` (the hosted API), `sarvam`, or `local` (a model on this machine,
# behind `mlx_lm.server` — see src/aigent/adapters/cfg_local.py for the command that starts it).
# Each client brings its own models, so switching this switches the three below with it.
# AIGENT_CLIENT=anthropic

# Three models, three jobs. AIGENT_MODEL is what aigent thinks with; drop it to claude-sonnet-5
# for cheaper experimentation. AIGENT_JUDGE_MODEL is what grades an eval, and defaults to a
# different model on purpose: one asked to grade its own output favours it. AIGENT_SMALL_MODEL is
# where the routing workflow sends the questions that do not need the first.
# AIGENT_MODEL=claude-opus-5
# AIGENT_JUDGE_MODEL=claude-sonnet-5
# AIGENT_SMALL_MODEL=claude-haiku-4-5

# Tracing to Langfuse: a project's key pair from Settings > API Keys at cloud.langfuse.com. Without
# both keys nothing is traced. LANGFUSE_HOST is https://cloud.langfuse.com for the EU region and
# https://us.cloud.langfuse.com for the US one.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# AIGENT_TRACING=off                    # switch it off with the keys still set
# AIGENT_TRACE_ENVIRONMENT=development  # what Langfuse files the traces under
